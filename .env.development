# UI:  npm run dev  →  :3008
#
# https://isaque.local:3008
# https://localhost:3008
# https://<LAN_IP>:3008  (celular na mesma rede)
# (Vite proxies /api/ e /uploads → pump.it API :3007)
#
# Não fixe VITE_DEV_ORIGIN / VITE_HMR_HOST em isaque.local:
# o S24 não resolve esse nome. HMR e assets seguem o host da URL.
#
VITE_API_URL=/api
# VITE_HTTPS=false
